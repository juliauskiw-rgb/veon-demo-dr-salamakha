---
// Functional icons only (phone, socials, map, disclosure, menu). Inline SVG, colour from currentColor.
interface Props { name: "phone" | "instagram" | "facebook" | "arrow" | "plus" | "menu" | "close" | "pin" | "mail"; size?: number; }
const { name, size = 20 } = Astro.props;
---
<svg class="icon" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {name === "phone" && <path d="M5 3.5h3.2l1.6 4.2-2 1.3a11 11 0 0 0 7.2 7.2l1.3-2 4.2 1.6V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.1 1.5 1.5 0 0 1 5 3.5Z" />}
  {name === "instagram" && <><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="3.9" /><circle cx="17.2" cy="6.8" r=".6" fill="currentColor" stroke="none" /></>}
  {name === "facebook" && <path d="M14 8.5h2.5V5H14a3.5 3.5 0 0 0-3.5 3.5V11H8v3.5h2.5V21H14v-6.5h2.4l.6-3.5h-3V9a.5.5 0 0 1 .5-.5Z" />}
  {name === "arrow" && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === "plus" && <path d="M12 5v14M5 12h14" />}
  {name === "menu" && <path d="M4 8h16M4 16h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "pin" && <><path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.3" /></>}
  {name === "mail" && <><rect x="3.5" y="5.5" width="17" height="13" rx="1.5" /><path d="m4 7 8 6 8-6" /></>}
</svg>
